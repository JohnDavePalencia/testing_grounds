#logo_transition_screen
def animate_splash(step=0):
    #grows_the_loading_bar_a_bit_each_time_blinks_the_cursor_then_closes_the_logo_screen
    global splash_job
    splash_canvas.coords(bar_fill, BAR_X + 1, BAR_Y + 1,
                         BAR_X + 1 + (BAR_W - 2) * step / SPLASH_STEPS, BAR_Y + BAR_H - 1)
    splash_canvas.itemconfig(percent_text, text=f"{100 * step // SPLASH_STEPS}%")

    #the_underscore_blinks_every_other_step_like_a_terminal_cursor
    cursor = "_" if (step // 2) % 2 == 0 else " "
    splash_canvas.itemconfig(loading_text, text="> LOADING STUDENT RECORDS" + cursor)

    if step >= SPLASH_STEPS:
        close_splash()
        return
    splash_job = root.after(SPLASH_MS // SPLASH_STEPS, animate_splash, step + 1)


def open_splash():
    #covers_the_whole_window_with_the_logo_screen_and_starts_the_loading_bar
    splash_frame.place(x=0, y=0, relwidth=1, relheight=1)
    splash_frame.lift()
    animate_splash(0)


def close_splash(event=None):
    #removes_the_logo_screen_so_the_student_manager_shows_underneath
    global splash_job
    if splash_job is not None:
        root.after_cancel(splash_job)
        splash_job = None
    splash_frame.place_forget()


#menu_options_1_to_4
def disp_all():
    #option_1_shows_every_student_then_the_class_summary
    if no_stdnts():
        return
    text = ""
    total_percentage = 0
    for s in stdnts:
        text += format_student(s) + "\n"
        total_percentage += get_prcnt(s)

    average = total_percentage / len(stdnts)
    text += f"Students in class:  {len(stdnts)}\n"
    text += f"Average percentage: {average:.1f}%"
    disp_txt(text)
    set_status(f"VIEWING ALL ({len(stdnts)})")


def disp_indiv():
