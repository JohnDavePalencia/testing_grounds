#reading_and_saving_the_file
def load_stdnts():
    #reads_the_file_and_gives_back_a_list_of_student_dictionaries
    student_list = []

    #no_file_means_no_students_nobody_turned_up_to_class
    try:
        file = open(FILE_NAME, "r", encoding="utf-8")
    except FileNotFoundError:
        return student_list

    lines = file.read().splitlines()
    file.close()

    for line in lines[1:]:  # skip_line_1_it_is_only_the_class_size
        if line.strip() == "":
            continue
        parts = line.split(",")

        #broken_lines_are_skipped_instead_of_crashing_the_program
        try:
            student = {
                "code": int(parts[0]),
                "name": parts[1].strip(),
                "c1": int(parts[2]),
                "c2": int(parts[3]),
                "c3": int(parts[4]),
                "exam": int(parts[5]),
            }
        except (ValueError, IndexError):
            continue

        student_list.append(student)
    return student_list


def save_stdnts():
    #writes_every_student_back_to_the_file_line_1_is_the_class_size
