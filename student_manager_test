        disp_txt("NO STUDENT DATA FOUND!\n"
                 "Check that studentMarks.txt is in the same folder.\n"
                 "(You can still use ADD STUDENT to create records.)")
        set_status("NO STUDENT DATA", "red")
        return True
    return False


def find_stdnt(search_text):
    #looks_for_a_student_by_code_or_name_gives_back_none_if_not_found
    search_text = search_text.strip().lower()
    for s in stdnts:
        if search_text == str(s["code"]) or search_text == s["name"].lower():
            return s
    return None


