def set_status(message, colour="lawngreen"):
    #adds_a_new_line_to_the_history_box_with_the_time_and_a_short_message
    #the_box_is_locked_so_it_is_unlocked_just_for_a_moment_to_write_to_it
    status_box.config(state="normal")
    status_box.tag_configure(colour, foreground=colour)
    status_box.insert(tk.END, time.strftime("%H:%M:%S") + " ", "time")
    status_box.insert(tk.END, "> " + message + "\n", colour)

    #keep_only_the_last_100_lines_so_the_history_does_not_grow_forever
    line_count = int(status_box.index("end-1c").split(".")[0])
    if line_count > 100:
        status_box.delete("1.0", "2.0")

    status_box.see(tk.END)  # scrolls_down_so_the_newest_line_is_always_visible
    status_box.config(state="disabled")


def no_stdnts():
    #if_the_list_is_empty_shows_a_message_and_gives_back_true
