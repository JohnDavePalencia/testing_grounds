#maths_for_the_marks
def get_coursework(student):
    #adds_up_the_three_coursework_marks_out_of_60
    return student["c1"] + student["c2"] + student["c3"]


def get_total(student):
    #coursework_plus_exam_out_of_160
    return get_coursework(student) + student["exam"]


def get_prcnt(student):
    #works_out_the_overall_percentage_using_the_160_marks
    return get_total(student) / 160 * 100


def get_grade(percentage):
    #turns_a_percentage_into_a_grade_hope_nobody_gets_an_f
    if percentage >= 70:
        return "A"
    elif percentage >= 60:
        return "B"
    elif percentage >= 50:
        return "C"
    elif percentage >= 40:
        return "D"
    else:
        return "F"


def format_student(student):
    #turns_one_student_into_nice_text_to_show_on_screen
    percentage = get_prcnt(student)
    text = f"Name:       {student['name']}\n"
    text += f"Number:     {student['code']}\n"
    text += f"Coursework: {get_coursework(student)} / 60\n"
    text += f"Exam:       {student['exam']} / 100\n"
    text += f"Overall:    {percentage:.1f}%\n"
    text += f"Grade:      {get_grade(percentage)}\n"
    return text


