def disp_high():
    #option_3_shows_student_with_the_highest_mark_top_of_the_class
    if no_stdnts():
        return

    best = stdnts[0]
    for s in stdnts:
        if get_total(s) > get_total(best):
            best = s
    disp_txt("HIGHEST SCORE\n\n" + format_student(best))
    set_status(f"HIGHEST: {best['name']}")


def disp_low():
    #option_4_shows_the_student_with_the_lowest_mark
    if no_stdnts():
        return

    worst = stdnts[0]
    for s in stdnts:
        if get_total(s) < get_total(worst):
            worst = s
    disp_txt("LOWEST SCORE\n\n" + format_student(worst))
    set_status(f"LOWEST: {worst['name']}")


#extension_option_5_sort
def disp_sorted(high_first):
    #shows_every_student_sorted_by_total_mark
    #key_is_what_sorted_compares_reverse_flips_the_order
    sorted_list = sorted(stdnts, key=get_total, reverse=high_first)
    text = ""
    for s in sorted_list:
        text += format_student(s) + "\n"
    disp_txt(text)
    set_status("SORTED HIGH-LOW" if high_first else "SORTED LOW-HIGH")


def sort_low_high():
    #option_5a_lowest_to_highest
    if no_stdnts():
        return
    disp_sorted(False)


def sort_high_low():
    #option_5b_highest_to_lowest
    if no_stdnts():
        return
    disp_sorted(True)


#extension_options_6_to_8_add_delete_update
def is_valid_num(text, low, high):
    #true_if_the_text_is_a_whole_number_between_low_and_high
    if not text.isdigit():
        return False
    number = int(text)
    return low <= number <= high


def read_details():
    #reads_the_details_boxes_gives_back_a_student_dictionary_or_none_if_something_is_wrong
    code = code_box.get().strip()
    name = name_box.get().strip()
    c1 = c1_box.get().strip()
    c2 = c2_box.get().strip()
    c3 = c3_box.get().strip()
    exam = exam_box.get().strip()

    if not is_valid_num(code, 1000, 9999):
        disp_txt("Code must be a whole number from 1000 to 9999.")
        set_status("INVALID CODE", "red")
        return None
    if name == "" or "," in name:
        disp_txt("Please enter a name (no commas).")
        set_status("INVALID NAME", "red")
        return None
    if (not is_valid_num(c1, 0, 20)
            or not is_valid_num(c2, 0, 20)
            or not is_valid_num(c3, 0, 20)):
        disp_txt("Each coursework mark must be a whole number from 0 to 20.")
        set_status("INVALID COURSEWORK", "red")
        return None
    if not is_valid_num(exam, 0, 100):
        disp_txt("Exam mark must be a whole number from 0 to 100.")
        set_status("INVALID EXAM MARK", "red")
        return None

    #all_good_so_make_a_student_from_the_boxes
    return {
        "code": int(code),
        "name": name,
        "c1": int(c1),
        "c2": int(c2),
        "c3": int(c3),
        "exam": int(exam),
    }


def add_stdnt():
    #option_6_adds_a_student_from_the_details_boxes_and_saves
    details = read_details()
    if details is None:
        return
    if find_stdnt(str(details["code"])) is not None:
        disp_txt("A student with that code already exists.")
        set_status("CODE ALREADY EXISTS", "red")
        return

    stdnts.append(details)
    save_stdnts()
    clear_form()
    disp_txt("STUDENT ADDED\n\n" + format_student(details))
    set_status(f"ADDED {details['name']} - FILE SAVED")


def del_stdnt():
    #option_7_deletes_the_student_in_the_search_box_and_saves
    s = find_stdnt(get_search_text())
    if s is None:
        disp_txt("Student not found.\nType a name or code in the SEARCH box.")
        set_status("STUDENT NOT FOUND", "red")
        return

    #popup_asks_are_you_sure_before_anything_is_deleted
    if not messagebox.askyesno("CONFIRM DELETE", f"Delete {s['name']} ({s['code']})?"):
        disp_txt("Delete cancelled.")
        set_status("DELETE CANCELLED")
        return

    stdnts.remove(s)
    save_stdnts()
    clear_form()
    disp_txt(f"DELETED: {s['name']} ({s['code']})")
    set_status(f"DELETED {s['name']} - FILE SAVED")


def upd_stdnt():
    #option_8_replaces_the_searched_students_details_with_the_details_boxes_and_saves
    s = find_stdnt(get_search_text())
    if s is None:
        disp_txt("Student not found.\nType a name or code in the SEARCH box.")
        set_status("STUDENT NOT FOUND", "red")
        return

    details = read_details()
    if details is None:
        return

    #changed_code_must_not_belong_to_somebody_else
    other = find_stdnt(str(details["code"]))
    if other is not None and other is not s:
        disp_txt("That code is already used by another student.")
        set_status("CODE ALREADY USED", "red")
        return

    s.update(details)  # copies_every_value_from_details_into_the_student
    save_stdnts()
    clear_form()
    disp_txt("STUDENT UPDATED\n\n" + format_student(s))
    set_status(f"UPDATED {s['name']} - FILE SAVED")


